[Unit]
Description=Robot Control System
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/orangepi/robo_control
ExecStart=/bin/bash -c 'source /home/orangepi/robo_control/install/setup.bash && ros2 launch /home/orangepi/robo_control/launch/robo.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
